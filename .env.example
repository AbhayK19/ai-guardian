# Core runtime
NODE_ENV=development
PORT=3000

# MySQL / Drizzle
DATABASE_URL=mysql://ai_guardian:ai_guardian@127.0.0.1:3306/ai_guardian

# Authentication and session security
JWT_SECRET=change-me
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional platform integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_APP_ID=

# Optional runtime integration
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FCM_SERVER_KEY=

# MSG91 account-phone OTP only; Android SOS uses the phone's SMS composer.
MSG91_AUTH_KEY=replace-with-server-side-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=replace-with-approved-otp-template-id
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_OTP_RESEND_SECONDS=60
PHONE_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public HTTPS origin used to create expiring emergency tracking links
PUBLIC_APP_URL=https://guardian.example.com
LIVE_LOCATION_EXPIRY_MINUTES=60
LOCATION_UPDATE_INTERVAL_SECONDS=30
